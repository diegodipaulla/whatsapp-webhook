// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // The binaryTarget is needed for Electron to know what binary to use.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Represents a single connected WhatsApp account
model WhatsappAccount {
  id        String   @id @default(cuid())
  wppId     String   @unique // The user's WhatsApp ID (e.g., 5511...@c.us)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  settings  Setting[]
  messages  Message[]
  queue     WebhookQueue[]
}

// Settings are now per-account
model Setting {
  id        String   @id @default(cuid())
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to a specific WhatsApp account
  account   WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  whatsappAccountId String

  @@unique([key, whatsappAccountId]) // A key must be unique per account
}

// Contacts are global, as they can be talked to by multiple accounts
model Contact {
  id        String    @id @default(cuid())
  chatId    String    @unique // e.g., 55119...@c.us
  name      String?   // Name from WA profile
  pushName  String?   // Name they set for themselves
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Messages are now per-account
model Message {
  id          String   @id @default(cuid())
  timestamp   BigInt
  body        String?
  hasMedia    Boolean
  mediaUrl    String? // Or store media info differently
  mediaMime   String?
  mediaFilename String?
  isQueued    Boolean  @default(false) // Is it in the webhook queue?
  createdAt   DateTime @default(now())

  // Relation to a specific WhatsApp account
  account   WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  whatsappAccountId String

  // Relation to a contact
  chat        Contact  @relation(fields: [contactId], references: [id])
  contactId   String
}

// The webhook queue is now per-account
model WebhookQueue {
  id          String   @id @default(cuid())
  payload     String // JSON string of the webhook payload
  status      String   @default("PENDING") // PENDING, SUCCESS, FAILED
  retryCount  Int      @default(0)
  lastAttempt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to a specific WhatsApp account
  account   WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  whatsappAccountId String
}
