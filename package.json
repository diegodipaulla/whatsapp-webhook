{
  "name": "whatsapp-webhook",
  "version": "1.0.0",
  "scripts": {
    "start:bot": "npx prisma migrate deploy && node index.js",
    "dev": "nodemon index.js",
    "start:terminal": "node bot.js",
    "start:electron": "electron electron.js",
    "dev:electron": "nodemon --exec \"electron .\"",
    "build:dashboard": "cd dashboard && npm run build",
    "start": "concurrently \"npm:start:bot\" \"npm:start:dashboard\"",
    "test": "jest",
    "start:dashboard": "cd dashboard && npm start",
    "postinstall": "cd dashboard && npm install"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "axios": "^1.12.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "puppeteer": "^23.11.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.21.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^29.7.0",
    "electron": "^38.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prisma": "^6.16.3",
    "webpack-dev-server": "^5.2.2"
  }
}